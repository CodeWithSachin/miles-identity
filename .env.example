# Miles Identity — copy to .env.local (gitignored). Bun loads .env files automatically.
# Read ONLY in src/lib/config.ts, validated with zod. Never Bun.env elsewhere.

# ── Runtime ───────────────────────────────────────────────────────────────────
NODE_ENV=development
PORT=3000
TZ=UTC                      # Bun.cron in-process schedules are UTC — keep these aligned
BASE_URL=http://localhost:3000

# ── Postgres ──────────────────────────────────────────────────────────────────
# Bun.sql picks this up automatically for our queries.
# Better Auth needs it too, via a pg Pool (Kysely requirement — see skills/better-auth.md).
DATABASE_URL=postgres://postgres:postgres@localhost:5432/miles_identity

# Legacy sources, read-only, used by the import/dedup jobs only.
LEGACY_LMS_DATABASE_URL=
LEGACY_MILES_ONE_DATABASE_URL=
LEGACY_MASTERCLASS_DATABASE_URL=

# ── Redis (Bun.redis) ─────────────────────────────────────────────────────────
REDIS_URL=redis://localhost:6379

# ── Better Auth ───────────────────────────────────────────────────────────────
BETTER_AUTH_SECRET=          # openssl rand -base64 32
BETTER_AUTH_URL=http://localhost:3000
ACCESS_TOKEN_TTL_SECONDS=900 # 15 min. Library default is 3600 — always override.

# ── OAuth clients (trusted, first-party) ──────────────────────────────────────
LMS_WEB_CLIENT_SECRET=
MASTERCLASS_WEB_CLIENT_SECRET=
# miles-one-app and masterclass-app are public clients — PKCE only, no secret.

# ── OpenFGA ───────────────────────────────────────────────────────────────────
FGA_API_URL=http://localhost:8080
FGA_STORE_ID=
FGA_MODEL_ID=
FGA_API_TOKEN=

# ── Email (transactional) ─────────────────────────────────────────────────────
EMAIL_PROVIDER_API_KEY=
EMAIL_FROM=no-reply@miles.com

# ── SMS / OTP ─────────────────────────────────────────────────────────────────
SMS_PROVIDER=                # gupshup | msg91 | twilio
SMS_PROVIDER_API_KEY=
SMS_SENDER_ID=
PHONE_PLACEHOLDER_DOMAIN=phone.miles.com   # NOT temp.better-auth.com

# ── Salesforce ────────────────────────────────────────────────────────────────
SALESFORCE_INSTANCE_URL=
SALESFORCE_CLIENT_ID=
SALESFORCE_CLIENT_SECRET=
INTERNAL_WEBHOOK_SIGNING_SECRET=   # verifies /api/internal/* callouts

# ── Social providers (optional) ───────────────────────────────────────────────
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
